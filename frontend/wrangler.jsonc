{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanban-sneakybeak-net",
  "compatibility_date": "2026-10-19",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "kanban.sneakybeak.net", "custom_domain": true }
  ]
}
