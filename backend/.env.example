# local dev mongo settings 
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=kanban_dev

# do not use this example jwt secret in prod environments or the website will burn down
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# cookie_secure should be true in prod environments
COOKIE_SECURE=false

# login rate limiting settings
LOGIN_USERNAME_LIMIT=5
LOGIN_USERNAME_WINDOW_SECONDS=900
LOGIN_GLOBAL_LIMIT=30
LOGIN_GLOBAL_WINDOW_SECONDS=300

# Integration tests require a running MongoDB replica set named rs0.
# Tests create and drop only generated kanban_test_<uuid> databases.
# Comment out MONGO_TEST_URL to skip database integration tests.
MONGO_TEST_URL=mongodb://localhost:27017/?replicaSet=rs0
